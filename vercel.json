{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/line/webhook",
      "destination": "/api/line/webhook"
    },
    {
      "source": "/api/:path*",
      "destination": "https://nhsoauthen.nhsotracker.site/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
